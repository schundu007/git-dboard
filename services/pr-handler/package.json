{
  "name": "isaaclab-pr-handler",
  "version": "1.0.0",
  "description": "GitHub App webhook handler for IsaacLab PR pre-merge gate",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build":    "tsc",
    "start":    "node dist/app.js",
    "dev":      "nodemon --exec 'tsx src/app.ts' --ext ts --ignore dist",
    "lint":     "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test":     "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@octokit/app":       "^15.1.0",
    "@octokit/rest":      "^20.1.0",
    "@octokit/webhooks":  "^13.3.0",
    "express":            "^4.18.3",
    "pino":               "^9.0.0",
    "pino-pretty":        "^11.0.0",
    "zod":                "^3.22.4"
  },
  "devDependencies": {
    "@types/express":      "^4.17.21",
    "@types/node":         "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser":        "^7.0.0",
    "eslint":              "^8.57.0",
    "nodemon":             "^3.1.0",
    "tsx":                 "^4.7.0",
    "typescript":          "^5.4.0",
    "vitest":              "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
