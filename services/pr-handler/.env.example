# .env.example — copy to .env for local development
# Never commit the real .env file.

# ── GitHub App credentials ─────────────────────────────────────────────────────
# From https://github.com/settings/apps/<your-app>

# The numeric App ID shown on the App settings page
GITHUB_APP_ID=123456

# Full PEM private key (can be base64-encoded for k8s secrets).
# In .env files, encode newlines as literal \n:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Webhook secret configured in the GitHub App settings
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Optional: pin to a specific installation ID (avoids the installations API lookup)
# GITHUB_INSTALLATION_ID=

# ── Target repository ──────────────────────────────────────────────────────────
REPO_OWNER=isaac-sim
REPO_NAME=IsaacLab

# ── HTTP server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Merge method used when auto-merge label is set: merge | squash | rebase
MERGE_METHOD=squash

# ── Logging ────────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── Node environment ───────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
