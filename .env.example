# ── GitHub ─────────────────────────────────────────────────────────────────
# Personal Access Token with repo + workflow + read:org scopes
GH_PAT=ghp_your_token_here
GH_OWNER=
GH_REPO=

# ── AWS ECR ─────────────────────────────────────────────────────────────────
# These match your ECR repo: 365506438424.dkr.ecr.us-east-1.amazonaws.com/issaclab/isaac
AWS_REGION=us-east-1
ECR_ACCOUNT_ID=
ECR_REPO=
# AWS credentials via env or ~/.aws/credentials / AWS SSO
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default

# ── NVIDIA NGC ──────────────────────────────────────────────────────────────
NGC_API_KEY=
NGC_ORG=

# ── Cluster SSH ─────────────────────────────────────────────────────────────
CLUSTER_HOST=your.cluster.hostname
CLUSTER_USER=your_username
CLUSTER_KEY_PATH=~/.ssh/id_rsa
CLUSTER_SCHEDULER=slurm   # slurm | pbs

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./gitpulse.db
