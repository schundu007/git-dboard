# Required
GH_PAT=ghp_your_token_here

# Repository defaults (can be overridden via the UI)
GH_OWNER=
GH_REPO=

# CORS — comma-separated list of allowed frontend origins
# Add your Vercel URL here after deploying
CORS_ORIGINS=https://your-app.vercel.app

# AWS / ECR (optional — only needed for registry features)
AWS_REGION=us-east-1
ECR_ACCOUNT_ID=
ECR_REPO=

# NGC (optional — only needed for NGC features)
NGC_API_KEY=
NGC_ORG=

# HPC cluster (optional)
CLUSTER_HOST=
CLUSTER_USER=
CLUSTER_KEY_PATH=
CLUSTER_SCHEDULER=slurm

# Database (Railway sets this automatically for Postgres; leave blank to use SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./gitpulse.db

# AI provider (GitPulse-scoped name to avoid clashing with other apps sharing the host)
ANTHROPIC_GITPULSE_API_KEY=
